<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon background layer.
    Uses a neutral off-white fill. The launcher clips this to the device's icon shape (circle, squircle, etc.)
    and the foreground is composited on top. On Android 13+ with themed icons enabled,
    the monochrome layer overrides both layers with the wallpaper-derived system color.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#F5F5F5"
        android:pathData="M0,0h108v108h-108z" />

</vector>
