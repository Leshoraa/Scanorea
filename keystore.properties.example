# Release signing configuration for Scanorea
#
# Copy this file to `keystore.properties` (same directory) and fill in the real values.
# `keystore.properties` and `*.jks` are git-ignored on purpose: never commit them.
#
# Generate a new key with:
#   keytool -genkeypair -v -keystore keystore/scanorea-release.jks \
#     -alias scanorea -keyalg RSA -keysize 4096 -validity 10000
#
# Then build a signed APK with:
#   ./gradlew assembleRelease
#
# IMPORTANT: back up `keystore/scanorea-release.jks` and the passwords. If the key is lost
# you can never publish an update that replaces an already installed Scanorea.

storeFile=keystore/scanorea-release.jks
storePassword=CHANGE_ME
keyAlias=scanorea
keyPassword=CHANGE_ME
